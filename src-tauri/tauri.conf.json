{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wireless AI Mic",
  "version": "0.1.0",
  "identifier": "dev.wirelessaimic.prototype",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:4317",
    "beforeBuildCommand": "node scripts/block-production.mjs",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "/react/",
        "title": "TalkCraft · 桌面助手",
        "width": 1000,
        "height": 900,
        "minWidth": 600,
        "minHeight": 500,
        "create": false
      },
      {
        "label": "hud",
        "url": "/?hud=1",
        "title": "TalkCraft 录音悬浮条",
        "width": 384,
        "height": 360,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "focusable": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "create": false
      },
      {
        "label": "keymap",
        "url": "/react/?panel=keymap",
        "title": "TalkCraft 快捷键提示",
        "width": 380,
        "height": 360,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": true,
        "visible": false,
        "create": false
      },
      {
        "label": "chat",
        "url": "/react/?panel=chat",
        "title": "TalkCraft 问答",
        "width": 480,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": false,
        "focus": true,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; media-src 'self' blob:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

